# Copy to .env (git-ignored). Read by docker compose, and passed to the app.
#
# Optional until the MariaDB migration (sub-issue #7): config.py uses this in
# place of its own SQLALCHEMY_DATABASE_URI, and `docker compose --profile db up`
# creates the db service's user, password and database from it. The host is
# "db". Use a password with no URL-special characters (@ : / % # ?).
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://tfc:CHANGE-ME@db/tfc
# Optional: address and port the app is published on (default 127.0.0.1:9999)
# TFC_BIND=127.0.0.1
# TFC_PORT=9999
