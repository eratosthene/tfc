# Copy to docker/.env (git-ignored; it holds secrets). Passed to the app as
# environment, and read by docker/compose.dev.yml. May be empty.
#
# config.py uses this in place of its own SQLALCHEMY_DATABASE_URI. Keep
# charset=utf8mb4. In the dev compose file the db service is created from it
# too, with host "db"; use a password with no URL-special characters
# (@ : / % # ?) and single-quote the value.
# SQLALCHEMY_DATABASE_URI='mysql+pymysql://tfc:CHANGE-ME@db/tfc?charset=utf8mb4'
