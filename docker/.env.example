# Copy to docker/.env (git-ignored; it holds secrets). Passed to the app as
# environment, and read by docker/compose.dev.yml. May be empty.
#
# Optional until the MariaDB migration (sub-issue #7): config.py uses this in
# place of its own SQLALCHEMY_DATABASE_URI. In the dev compose file the db
# service is created from it too, with host "db"; use a password with no
# URL-special characters (@ : / % # ?) and single-quote the value.
# SQLALCHEMY_DATABASE_URI='mysql+pymysql://tfc:CHANGE-ME@db/tfc'
