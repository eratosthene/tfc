[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
pytest = "*"
pytest-cov = "*"
pre-commit = "*"

[packages]
# Flask 3 / Werkzeug 3 (sub-issue 13). Newer Flask-AppBuilder releases allow them.
flask = ">=3,<4"
flask-appbuilder = "==5.3.0"
werkzeug = ">=3,<4"
# Sub-issue 12: FAB 5 is the first release that allows SQLAlchemy 2 and
# Flask-SQLAlchemy 3 (FAB 4.8.1 needed <1.5 and <3).
flask-migrate = ">=4,<5"
flask-sqlalchemy = ">=3,<4"
sqlalchemy = ">=2,<3"
# SQLAlchemy needs it only on some platforms, so a lock made on a Mac omits it.
greenlet = "*"
pymysql = "*"
gunicorn = "*"
python-dotenv = "*"
pillow = ">=12"
# PyYAML 6.0 does not build on 3.12.
pyyaml = ">=6.0.1"

[requires]
python_version = "3.12"
