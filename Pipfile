[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
pytest = "*"
pytest-cov = "*"
pre-commit = "*"

[packages]
# Step 1 of the dependency upgrades (sub-issue 11). FAB 4.8.1 is the last 4.x;
# it needs Flask <3. Flask 2.2.5 is the newest Flask that Flask-SQLAlchemy 2.5
# (held by FAB 4.x, <3) still works with: Flask 2.3 removed _app_ctx_stack.
# Werkzeug 2.3 is the newest Flask 2.2.5 supports (2.2.5 was released for
# it) and the first with scrypt, which FAB 4.8 uses to hash new passwords.
flask = "==2.2.5"
flask-appbuilder = "==4.8.1"
werkzeug = "==2.3.8"
# The remaining majors are held for sub-issues 12 and 13.
flask-migrate = "<4"
flask-restful = "*"
flask-sqlalchemy = "<3"
sqlalchemy = "<2"
# SQLAlchemy 1.4 needs it only on some platforms, so a lock made on a Mac omits it.
greenlet = "*"
pymysql = "*"
gunicorn = "*"
python-dotenv = "*"
# 10.1 is the first Pillow with Python 3.12 wheels.
pillow = ">=13.0.0,<14"
# PyYAML 6.0 does not build on 3.12.
pyyaml = ">=6.0.1"

[requires]
python_version = "3.12"
